* text=auto

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.xlsx binary
*.xlsm binary
*.xls binary
*.docx binary
*.pptx binary

# Preserve archived evidence bytes so recorded SHA256 values survive checkout.
data/peer_fundamentals/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/peer_research/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
data/fundamental_cases/** -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
